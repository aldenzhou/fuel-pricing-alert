# Telegram Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Chat ID that receives technical failure notifications (developer only).
# Leave blank to disable developer alerts.
DEVELOPER_CHAT_ID=your_developer_chat_id_here

# NSW API Credentials
NSW_API_KEY=your_api_key_here
NSW_AUTH_HEADER=Basic your_authorization_header_string_here

# Google Sheets
GOOGLE_SHEET_NAME=Name_Of_Your_Google_Sheet
GOOGLE_CREDS_FILE=keys/google_credentials.json

# Character used to separate multiple values within a single sheet cell
# (e.g. several Fuel Types or Telegram Chat IDs). Defaults to a comma if unset.
FIELD_DELIMITER=,

# Default Telegram Chat ID(s) applied to rows added by add_alert_locations.py.
# Separate multiple IDs with FIELD_DELIMITER. Can be overridden with --chat-ids.
DEFAULT_ALERT_CHAT_IDS=your_chat_id_here
